	<array>
		<string>identifier "org.waypnt.waypoint" and anchor apple generic and certificate leaf[subject.OU] = "N48L43Q7F9"</string>
	</array>
	<key>SMPrivilegedExecutables</key>
	<dict>
		<key>org.waypnt.waypoint.ProxyConfigHelper</key>
		<string>anchor apple generic and identifier "org.waypnt.waypoint.ProxyConfigHelper" and certificate leaf[subject.OU] = N48L43Q7F9</string>
	</dict>
	<key>SUDisallowSelectChannel</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://michaelleee.github.io/Waypoint/appcast.xml</string>
