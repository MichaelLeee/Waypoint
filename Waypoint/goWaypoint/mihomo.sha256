# Supply-chain pin for the bundled mihomo core.
#
# The default build path compiles the tag pinned here from source on the
# building machine (bundle_mihomo.py), so the commit= line is the primary
# trust anchor. The asset hashes were computed from the official GitHub
# release at pin time (MetaCubeX publishes no checksums/signatures) and are
# used by --official mode and by the CI comparison job. To upgrade: change
# version= and commit= here, review the upstream diff, and refresh the asset
# hashes (bundle_mihomo.py --official --version <new> prints them).
version=1.19.30
commit=ac017cdd246ce8bd547653d927e7bf77d7ee73d5
